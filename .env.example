# ---- App ----
APP_NAME=Knowledge QA
DEBUG=true

# ---- Database (matches docker-compose.yml) ----
DATABASE_URL=postgresql+psycopg://kqa:kqa_pass@127.0.0.1:5432/knowledge_qa

# ---- Auth ----
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_MINUTES=120
REFRESH_TOKEN_DAYS=7

# ---- Bailian / DashScope ----
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
EMBED_MODEL=text-embedding-v4
RERANK_MODEL=gte-rerank-v2
RERANK_ENABLED=true

# ---- Indexing ----
CHUNK_SIZE=500
CHUNK_OVERLAP=80
EMBED_BATCH=10
MAX_UPLOAD_MB=50
MAX_CHUNKS_PER_DOC=4000
UPLOAD_DIR=uploads

# ---- Retrieval ----
TOP_K=6
VECTOR_TOP_K=50
KEYWORD_TOP_K=20
