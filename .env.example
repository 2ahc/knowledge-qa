# 配置模板：复制为 .env 并填入真实值。所有项均可被环境变量覆盖。

# ---- 应用 ----
APP_NAME=Knowledge QA
DEBUG=true

# ---- 数据库（与 docker-compose.yml 保持一致；容器内会被 compose 覆盖）----
DATABASE_URL=postgresql+psycopg://kqa:kqa_pass@127.0.0.1:5432/knowledge_qa

# ---- 认证 ----
JWT_SECRET=change-me-in-production  # 生产环境务必修改！
ACCESS_TOKEN_MINUTES=120  # 访问令牌有效期（分钟）
REFRESH_TOKEN_DAYS=7  # 刷新令牌有效期（天）

# ---- 百炼 / DashScope（模型服务）----
DASHSCOPE_API_KEY=  # 必填：阿里云百炼 API Key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus  # 生成回答的大模型
EMBED_MODEL=text-embedding-v4  # 向量化模型（1024 维，改动需重建全部索引）
RERANK_MODEL=gte-rerank-v2  # 重排模型
RERANK_ENABLED=true  # 关闭重排可降成本，但检索质量下降

# ---- 索引（文档切片与向量化）----
CHUNK_SIZE=500  # 单切片最大字符数
CHUNK_OVERLAP=80  # 相邻切片重叠字符数
EMBED_BATCH=10  # 每次向量化接口的批量大小
MAX_UPLOAD_MB=50  # 单文件上传上限（MB）
MAX_CHUNKS_PER_DOC=4000  # 单文档最大切片数
UPLOAD_DIR=uploads  # 上传文件根目录

# ---- 检索 ----
TOP_K=6  # 送给大模型的引用材料条数
VECTOR_TOP_K=50  # 向量检索粗排召回条数
KEYWORD_TOP_K=20  # 关键词检索粗排召回条数
